# Local Docker development environment example.
#
# Copy this file to .env.docker, then start the local stack with:
# docker compose --env-file .env.docker up
#
# Docker Compose automatically loads the tracked docker-compose.override.yaml.
#
# This file contains only settings required by Docker Compose or settings whose
# defaults are unsuitable inside Docker containers.

# Django and Nginx
DOMAIN_NAME=localhost

# PostgreSQL
DB_NAME=django_articles
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db

# Redis
REDIS_HOST=redis

# Required by the base Compose configuration, even though local Nginx uses HTTP
CERTBOT_EMAIL=admin@example.com

# Format: username:password
FLOWER_BASIC_AUTH=flower_admin:flower_password
