# Production environment example.
#
# Copy this file to .env on the production server and replace all placeholders.
# Never commit the real .env file.

# -----------------------------------------------------------------------------
# Required: Django
# -----------------------------------------------------------------------------

SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=example.com,www.example.com
DOMAIN_NAME=example.com

# Usually unnecessary for same-origin requests.
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# -----------------------------------------------------------------------------
# Required: PostgreSQL
# -----------------------------------------------------------------------------

DB_NAME=django_articles
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=db

# Optional PostgreSQL settings
# DB_PORT=5432
# DB_CONNECTION_MAX_AGE=60

# -----------------------------------------------------------------------------
# Required: Redis
# -----------------------------------------------------------------------------

REDIS_HOST=redis

# Optional Redis settings
# REDIS_PORT=6379
# REDIS_CACHE_URL=redis://redis:6379/0
# REDIS_SELECT2_URL=redis://redis:6379/1
# REDIS_CHANNELS_URL=redis://redis:6379/2
# REDIS_CELERY_BROKER_URL=redis://redis:6379/3
# REDIS_CELERY_RESULT_URL=redis://redis:6379/4

# -----------------------------------------------------------------------------
# Required: Amazon S3 media storage
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=replace-with-s3-bucket-name
MEDIA_ALLOWED_ROOT_URLS=https://replace-with-s3-bucket-name.s3.amazonaws.com

# Optional media settings
# MAX_IMAGE_UPLOAD_FILE_SIZE=5242880

# -----------------------------------------------------------------------------
# Required: Google OAuth
# -----------------------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret

# -----------------------------------------------------------------------------
# Required: Email credentials
# -----------------------------------------------------------------------------

EMAIL_HOST_USER=admin@example.com
EMAIL_HOST_PASSWORD=replace-with-email-app-password

# Optional email settings
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_TASK_MAX_RETRIES=3
# EMAIL_TASK_BASE_RETRY_DELAY=60
# EMAIL_TASK_EXPONENTIAL_BACKOFF_FACTOR=2

# -----------------------------------------------------------------------------
# Required: hCaptcha
# -----------------------------------------------------------------------------

HCAPTCHA_SITEKEY=replace-with-hcaptcha-site-key
HCAPTCHA_SECRET=replace-with-hcaptcha-secret

# -----------------------------------------------------------------------------
# Required: Nginx, Certbot and Flower
# -----------------------------------------------------------------------------

CERTBOT_EMAIL=admin@example.com

# Format: username:password
FLOWER_BASIC_AUTH=flower_admin:replace-with-a-strong-password

# -----------------------------------------------------------------------------
# Optional: General application settings
# -----------------------------------------------------------------------------

# DEFAULT_USER_TZ=Europe/London
# ALLOW_NON_ROUTABLE_IPS=0
# RATELIMIT_ENABLE=1

# -----------------------------------------------------------------------------
# Optional: Logging
# -----------------------------------------------------------------------------

# ENABLE_LOGGING=0
# LOG_TO_CONSOLE=0
# LOGS_PATH=logs
# DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Optional: Sentry
# -----------------------------------------------------------------------------

# SENTRY_DSN is required when USE_SENTRY=1.
# USE_SENTRY=0
# SENTRY_DSN=https://replace-with-sentry-dsn
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_SEND_DEFAULT_PII=0

# -----------------------------------------------------------------------------
# Optional: Celery
# -----------------------------------------------------------------------------

# CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=1

# -----------------------------------------------------------------------------
# Optional: Noninteractive superuser creation
# -----------------------------------------------------------------------------

# These are used by Django's createsuperuser command, not by application settings.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password

# -----------------------------------------------------------------------------
# Optional: Articles app
# -----------------------------------------------------------------------------

# ARTICLES_ALLOWED_ARTICLE_CONTENT_URL_SCHEMES=https
# ARTICLES_ALLOWED_ARTICLE_INTERNAL_LINK_HOSTS=example.com,www.example.com
# ARTICLES_PER_PAGE=5
# ARTICLES_COMMENTS_PER_PAGE=20
# ARTICLES_UNIQUE_VIEW_WINDOW_SECONDS=3600
# ARTICLES_SLUG_ID_CACHE_TIMEOUT_SECONDS=3600
# ARTICLES_DETAIL_PAGE_CACHE_TIMEOUT_SECONDS=300
# ARTICLES_VIEW_COUNT_SYNC_MAX_ITERATIONS=20
# ARTICLES_VIEW_COUNT_SYNC_MAX_BATCH_SIZE=500

# -----------------------------------------------------------------------------
# Optional: Notifications app
# -----------------------------------------------------------------------------

# NOTIFICATIONS_WS_DETAILED_NOTIFICATION_COOLDOWN_SECONDS=2
# NOTIFICATIONS_WS_DIGEST_HINT_COOLDOWN_SECONDS=30
# NOTIFICATIONS_WS_GROUP_SEND_TIMEOUT_SECONDS=1
# NOTIFICATIONS_WS_ACCEPT_TIMEOUT_SECONDS=5
# NOTIFICATIONS_WS_GROUP_OPERATION_TIMEOUT_SECONDS=2
# NOTIFICATIONS_WS_SEND_JSON_TIMEOUT_SECONDS=2
# NOTIFICATIONS_READ_RETENTION_DAYS=90
# NOTIFICATIONS_CLEANUP_BATCH_SIZE=5000
# NOTIFICATIONS_CLEANUP_MAX_BATCHES=10
# NOTIFICATIONS_CLEANUP_LOCK_TTL_SECONDS=5400
# NOTIFICATIONS_UNREAD_COUNT_SYNC_LOCK_TTL_SECONDS=1800
# NOTIFICATIONS_UNREAD_COUNT_SYNC_BATCH_SIZE=1000

# -----------------------------------------------------------------------------
# Optional: Users app
# -----------------------------------------------------------------------------

# USERS_SUBSCRIBERS_COUNT_CACHE_TIMEOUT_SECONDS=300
# USERS_PENDING_EMAIL_CHANGE_TTL_SECONDS=7200
